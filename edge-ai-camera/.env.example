# Webcam index (usually 0)
CAMERA_INDEX=0
CAMERA_ID=webcam-01
CAMERA_NAME=Laptop webcam
CAMERA_SOURCE=webcam
PHONE_STREAM_URL=http://192.168.1.50:8080/video

# Capture and motion settings
FPS=30
BUFFER_SECONDS=5
MOTION_THRESHOLD=25
MIN_CONTOUR_AREA=800
BLUR_SIZE=21
NO_MOTION_TIMEOUT=3.0
RESIZE_WIDTH=640

# Video output
EVENTS_DIR=storage/events
VIDEO_FOURCC=mp4v

# Set to false to run without an OpenCV preview window
SHOW_PREVIEW=true

# Existing Computer-Vision project models (paths relative to edge-ai-camera)
INFERENCE_ENABLED=false
INFERENCE_INTERVAL=0.2
ANOMALY_THRESHOLD=0.5
YOLO_CONFIDENCE=0.35
ANOMALY_MODEL_PATH=../tested_models/7_train_7_finetune/model_final.keras
YOLO_MODEL_PATH=../weights/yolo26s.pt

# Phone-to-laptop local stream receiver and backend transfer
BACKEND_URL=http://127.0.0.1:8000
BACKEND_UPLOAD_ENABLED=true
UPLOAD_QUEUE_DIR=storage/upload_queue
BACKEND_DB_PATH=storage/backend.db
BACKEND_MEDIA_DIR=storage/backend_media
